# === Secrets / environment ===
# .env holds the live build-time config. Never commit it — commit .env.example.
.env
.env.local
.env.*.local
!.env.example

# === Node ===
node_modules/
npm-debug.log
yarn-error.log
*.tsbuildinfo
.npm/

