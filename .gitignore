.metro-health-check*
metro-cache/
*.jsbundle

# === Android ===
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/app/release/
android/local.properties
android/.cxx/
*.keystore
!debug.keystore
*.apk
*.aab

