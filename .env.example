# VOX build-time configuration.
#
# Copy to `.env` and adjust. `.env` is gitignored; this file is the committed
# template. Values are injected at build time by react-native-config and read
# through `src/config/env.ts` — never import react-native-config directly in
# feature code, so tests can run without the native module.
#
#   cp .env.example .env
#
# NOTE: react-native-config bakes these into the APK at build time. They are
# NOT secrets in any meaningful sense — anyone with the APK can read them.
# Nothing sensitive belongs here, which is fine: VOX has no server, no API
# keys, and no accounts by design.

# --- Mesh transport ------------------------------------------------------
# Which transport carries mesh packets. This is the single flag that encodes
# the outcome of the BLE spike (see docs/FALLBACKS.md):
#   ble      Plan A — BLE broadcast mesh (real multi-hop)
#   wifi     Plan B — local WiFi hotspot hub, the WarpChat/BDIX approach
#   loopback Dev only — in-process fake, no radio, for simulator work
VOX_MESH_TRANSPORT=ble

# --- BLE (Plan A) --------------------------------------------------------
# 16-bit company identifier used in the BLE manufacturer-data field.
# 0xFFFF is the Bluetooth SIG value reserved for internal/testing use, which
# is exactly what an unregistered project like this should be using.
VOX_BLE_MANUFACTURER_ID=65535

# 128-bit service UUID advertised alongside the payload, so scanners can
# filter VOX traffic out of the noise instead of parsing every advertisement.
VOX_BLE_SERVICE_UUID=7b8e5a10-9f34-4c21-8a6d-1f2e3c4d5b60

# How long (ms) a single advertisement frame stays on air before the next
# frame in a chunked packet replaces it. Lower = faster packets, more radio
# churn. 220ms comfortably exceeds Android's ~100ms advertising interval.
VOX_BLE_FRAME_INTERVAL_MS=220

# --- WiFi hub (Plan B) ---------------------------------------------------
# WebSocket URL of the local relay hub. 192.168.43.1 is the default gateway
# address Android assigns to itself when hosting a hotspot, so a phone-hosted
# hub usually needs no change here. A laptop-hosted hub needs its LAN IP.
VOX_WIFI_HUB_URL=ws://192.168.43.1:8787

# Port the bundled hub server (server/) listens on. Must match the URL above.
VOX_WIFI_HUB_PORT=8787

# --- Mesh behaviour ------------------------------------------------------
# Max hops a packet travels before dying out. Raising this widens reach but
# multiplies rebroadcast traffic in a dense crowd — see CONTEXT.md risk #3.
VOX_MESH_MAX_TTL=5

# How long (ms) a node remembers a packet id for de-duplication. Must exceed
# the time a packet can plausibly still be circulating, or you get loops.
VOX_RELAY_SEEN_TTL_MS=600000

# Drop a peer from the "nearby devices" count if unheard from for this long.
VOX_PEER_TIMEOUT_MS=60000

# --- Debug ---------------------------------------------------------------
# Verbose mesh logging. MUST be false for any real-world build: the logs
# include packet contents and peer ids, which is exactly the metadata this
# app exists to not leak.
VOX_DEBUG_LOGS=false
